+/**
+ * Verify a complete close using fills from exact Binance order IDs.
+ * Funding rows are deliberately rejected: income history does not identify
+ * the Hedge position side, so symbol/time matching alone is not sufficient.
+ */
+export function verifyClosingFills(
+  active: AgentTradeRecord,
+  closingOrderIds: string[],
+  fills: any[],
+  fundingRows: any[],
+  now = Date.now()
+): { exitPrice: number; realizedPnl: number; tradingFees: number; fundingFees: number } {
+  const settlementAsset = String(active.settlementAsset || '').trim();
+  if (!settlementAsset) throw new Error('Trade journal has no settlement asset; outcome cannot be verified');
+  if (!Array.isArray(closingOrderIds) || closingOrderIds.length === 0) {
+    throw new Error('No exact bot-owned closing order ID was identified');
+  }
+  const normalizedIds = closingOrderIds.map(normalizeExchangeOrderId);
+  if (normalizedIds.some((id) => !id) || new Set(normalizedIds).size !== normalizedIds.length) {
+    throw new Error('Closing order IDs are invalid or duplicated');
+  }
+  const allowedOrderIds = new Set(normalizedIds as string[]);
+  if (!Array.isArray(fills) || fills.length === 0) {
+    throw new Error('Exact closing-order fill history is empty or may be truncated');
+  }
+
+  const expectedSide = active.side === 'BUY' ? 'SELL' : 'BUY';
+  const expectedQty = finiteExchangeNumber(active.executedQuantity);
+  if (expectedQty === null || expectedQty <= 0) {
+    throw new Error('Journal executed quantity is invalid');
+  }
+
+  let totalQty = 0;
+  let totalQuote = 0;
+  let realizedPnl = 0;
+  let tradingFees = 0;
+  const seenTradeIds = new Set<string>();
+  const fillsPerOrder = new Map<string, number>();
+
+  for (const fill of fills) {
+    const orderId = normalizeExchangeOrderId(fill?.orderId);
+    if (!orderId || !allowedOrderIds.has(orderId)) {
+      throw new Error('A returned fill does not match one of the exact closing order IDs');
+    }
+    if (fill?.symbol !== active.symbol) throw new Error('Closing fill symbol mismatch');
+    if (fill?.side !== expectedSide) throw new Error('Closing fill side mismatch');
+    if (fill?.positionSide !== active.positionSide) throw new Error('Closing fill positionSide mismatch');
+
+    const tradeId = normalizeExchangeOrderId(fill?.id);
+    if (!tradeId || seenTradeIds.has(tradeId)) throw new Error('Closing fill trade ID is missing or duplicated');
+    seenTradeIds.add(tradeId);
+
+    const qty = finiteExchangeNumber(fill?.qty);
+    const price = finiteExchangeNumber(fill?.price);
+    const fillRealized = finiteExchangeNumber(fill?.realizedPnl);
+    const commission = finiteExchangeNumber(fill?.commission);
+    const fillTime = finiteExchangeNumber(fill?.time);
+    if (qty === null || qty <= 0 || price === null || price <= 0 || fillRealized === null ||
+        commission === null || commission < 0 || fillTime === null) {
+      throw new Error('Closing fill contains missing or invalid financial fields');
+    }
+    if (fillTime < active.openedAt - 2_000 || fillTime > now + 60_000) {
+      throw new Error('Closing fill timestamp is outside the tracked trade window');
+    }
+    if (fill?.commissionAsset !== settlementAsset || fill?.marginAsset !== settlementAsset) {
+      throw new Error('Closing fill commission/margin asset does not match the journal settlement asset');
+    }
+
+    totalQty += qty;
+    totalQuote += qty * price;
+    realizedPnl += fillRealized;
+    tradingFees += commission;
+    fillsPerOrder.set(orderId, (fillsPerOrder.get(orderId) || 0) + 1);
+  }
+
+  for (const orderId of allowedOrderIds) {
+    if (!fillsPerOrder.has(orderId)) throw new Error(`No fills were returned for closing order ${orderId}`);
+  }
+
+  const quantityTolerance = Math.max(1e-10, expectedQty * 1e-8);
+  if (Math.abs(totalQty - expectedQty) > quantityTolerance) {
+    throw new Error(`Closing fill quantity mismatch (expected ${expectedQty}, matched ${totalQty})`);
+  }
+
+  const previouslyAccruedFunding = finiteExchangeNumber(active.fundingFees);
+  if (previouslyAccruedFunding !== null && Math.abs(previouslyAccruedFunding) > 1e-10) {
+    throw new Error('Journal contains previously accrued symbol-level funding that cannot be attributed to this position side');
+  }
+  if (!Array.isArray(fundingRows)) throw new Error('Binance returned an invalid funding history response');
+  if (fundingRows.length >= 1000) throw new Error('Funding history may be truncated; reconciliation remains pending');
+  if (fundingRows.length > 0) {
+    // Funding rows do not identify Hedge positionSide. Do not guess which position received/paid them.
+    throw new Error('Funding fee rows exist but cannot be uniquely attributed to this position side');
+  }
+
+  const exitPrice = totalQuote / totalQty;
+  if (!Number.isFinite(exitPrice) || exitPrice <= 0 || !Number.isFinite(realizedPnl) ||
+      !Number.isFinite(tradingFees)) {
+    throw new Error('Matched close fills produced invalid financial totals');
+  }
+  return { exitPrice, realizedPnl, tradingFees, fundingFees: 0 };
+}
