+export async function resolveBotExitOrderIds(
+  active: AgentTradeRecord,
+  binanceRequest: BinanceRequestFn,
+  credentials: DemoCredentials
+): Promise<string[]> {
+  const ids = new Set<string>();
+  for (const id of active.exitOrderIds || []) {
+    const normalized = normalizeExchangeOrderId(id);
+    if (normalized) ids.add(normalized);
+  }
+  const emergencyId = normalizeExchangeOrderId(active.emergencyOrderId);
+  if (emergencyId) ids.add(emergencyId);
+  // Retain previously recovered child order IDs, but always re-query both
+  // Algo orders. A cached ID must not hide an Algo that remains active or
+  // triggers after an emergency close attempt.
+
+  if (!emergencyId && active.emergencyClientOrderId) {
+    const order = await binanceRequest<any>(
+      'GET',
+      '/fapi/v1/order',
+      { symbol: active.symbol, origClientOrderId: active.emergencyClientOrderId },
+      true,
+      credentials
+    );
+    if (order?.symbol !== active.symbol || order?.clientOrderId !== active.emergencyClientOrderId) {
+      throw new Error('Emergency order lookup did not match the stored symbol/clientOrderId');
+    }
+    const executedQty = finiteExchangeNumber(order.executedQty);
+    const foundId = normalizeExchangeOrderId(order.orderId);
+    if (executedQty === null || executedQty <= 0 || !foundId) {
+      throw new Error('Emergency order has no verifiable executed quantity/order ID');
+    }
+    ids.add(foundId);
+  }
+
+  const algos = [
+    { algoId: active.stopAlgoId, clientAlgoId: active.stopClientAlgoId },
+    { algoId: active.targetAlgoId, clientAlgoId: active.targetClientAlgoId },
+  ];
+  for (const algo of algos) {
+    if (!algo.algoId && !algo.clientAlgoId) continue;
+    const lookup: Record<string, any> = algo.algoId
+      ? { algoId: algo.algoId }
+      : { clientAlgoId: algo.clientAlgoId };
+    const response = await binanceRequest<any>(
+      'GET',
+      '/fapi/v1/algoOrder',
+      lookup,
+      true,
+      credentials
+    );
+    if (!response || response.symbol !== active.symbol) {
+      throw new Error('Binance algo-order lookup returned a different or missing symbol');
+    }
+    if (algo.algoId && String(response.algoId) !== String(algo.algoId)) {
+      throw new Error('Binance algo-order ID does not match the journal');
+    }
+    if (!algo.algoId && algo.clientAlgoId && response.clientAlgoId !== algo.clientAlgoId) {
+      throw new Error('Binance clientAlgoId does not match the journal');
+    }
+    const algoStatus = String(response.algoStatus || 'UNKNOWN').toUpperCase();
+    const actualOrderId = normalizeExchangeOrderId(response.actualOrderId);
+    if (actualOrderId) {
+      if (!['TRIGGERED', 'FINISHED'].includes(algoStatus)) {
+        throw new Error(`Algo order has child order ${actualOrderId} but is not in a terminal triggered state (${algoStatus})`);
+      }
+      ids.add(actualOrderId);
+    } else if (!['CANCELED', 'EXPIRED', 'REJECTED'].includes(algoStatus)) {
+      // NEW/TRIGGERING means a protective order may still fire. Keep the trade
+      // unresolved; this code deliberately does not cancel the order.
+      throw new Error(`Protective algo order remains active or unresolved (status ${algoStatus}); manual recovery is required before finalizing the trade`);
+    }
+  }
+
+  if (ids.size === 0) throw new Error('No triggered algo order or emergency close order ID could be recovered');
+  return Array.from(ids);
+}
