+/**
+ * Verify all fills for the exact entry order and account for entry commissions.
+ * Entry fees are part of net trade PnL and must not be omitted from learning.
+ */
+export function verifyEntryFills(
+  active: AgentTradeRecord,
+  fills: any[],
+  now = Date.now()
+): number {
+  const settlementAsset = String(active.settlementAsset || '').trim();
+  const entryOrderId = normalizeExchangeOrderId(active.entryOrderId);
+  if (!settlementAsset) throw new Error('Trade journal has no settlement asset; outcome cannot be verified');
+  if (!entryOrderId) throw new Error('Trade journal has no valid exact entry order ID');
+  if (!Array.isArray(fills) || fills.length === 0 || fills.length >= 1000) {
+    throw new Error('Exact entry-order fill history is empty, invalid, or may be truncated');
+  }
+
+  const expectedQty = finiteExchangeNumber(active.executedQuantity);
+  if (expectedQty === null || expectedQty <= 0) throw new Error('Journal executed quantity is invalid');
+  const earliest = active.openedAt - 5 * 60_000;
+  const latest = Math.min(now + 60_000, active.openedAt + 5 * 60_000);
+  let totalQty = 0;
+  let entryFees = 0;
+  const seenTradeIds = new Set<string>();
+
+  for (const fill of fills) {
+    if (normalizeExchangeOrderId(fill?.orderId) !== entryOrderId) {
+      throw new Error('An entry fill does not match the exact journal entry order ID');
+    }
+    if (fill?.symbol !== active.symbol) throw new Error('Entry fill symbol mismatch');
+    if (fill?.side !== active.side) throw new Error('Entry fill side mismatch');
+    if (fill?.positionSide !== active.positionSide) throw new Error('Entry fill positionSide mismatch');
+
+    const tradeId = normalizeExchangeOrderId(fill?.id);
+    if (!tradeId || seenTradeIds.has(tradeId)) throw new Error('Entry fill trade ID is missing or duplicated');
+    seenTradeIds.add(tradeId);
+
+    const qty = finiteExchangeNumber(fill?.qty);
+    const price = finiteExchangeNumber(fill?.price);
+    const realized = finiteExchangeNumber(fill?.realizedPnl);
+    const commission = finiteExchangeNumber(fill?.commission);
+    const fillTime = finiteExchangeNumber(fill?.time);
+    if (qty === null || qty <= 0 || price === null || price <= 0 || realized === null ||
+        Math.abs(realized) > 1e-8 || commission === null || commission < 0 || fillTime === null) {
+      throw new Error('Entry fill contains missing or invalid financial fields');
+    }
+    if (fillTime < earliest || fillTime > latest) {
+      throw new Error('Entry fill timestamp is outside the journal entry window');
+    }
+    if (fill?.commissionAsset !== settlementAsset || fill?.marginAsset !== settlementAsset) {
+      throw new Error('Entry fill commission/margin asset does not match the journal settlement asset');
+    }
+
+    totalQty += qty;
+    entryFees += commission;
+  }
+
+  const quantityTolerance = Math.max(1e-10, expectedQty * 1e-8);
+  if (Math.abs(totalQty - expectedQty) > quantityTolerance) {
+    throw new Error(`Entry fill quantity mismatch (expected ${expectedQty}, matched ${totalQty})`);
+  }
+  if (!Number.isFinite(entryFees)) throw new Error('Entry commissions produced an invalid total');
+  return entryFees;
+}
